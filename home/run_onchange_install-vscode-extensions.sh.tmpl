#!/usr/bin/env bash
set -euo pipefail

# extensions hash: {{ include ".assets/vscode-extensions.txt" | sha256sum }}

if ! command -v code >/dev/null 2>&1; then
  echo "code CLI not found, skipping extension install"
  exit 0
fi

LIST="{{ .chezmoi.sourceDir }}/.assets/vscode-extensions.txt"

failed=()
while IFS= read -r ext; do
  [ -z "${ext}" ] && continue
  case "${ext}" in
    \#*) continue ;;
  esac
  code --install-extension "${ext}" --force >/dev/null 2>&1 || failed+=("${ext}")
done < "${LIST}"

if [ ${#failed[@]} -gt 0 ]; then
  echo "vscode extensions: ${#failed[@]} failed (renamed/removed from marketplace?): ${failed[*]}"
fi
echo "vscode extensions sync complete"
