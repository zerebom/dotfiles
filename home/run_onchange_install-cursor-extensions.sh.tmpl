#!/usr/bin/env bash
set -euo pipefail

# extensions hash: {{ include ".assets/cursor-extensions.txt" | sha256sum }}

if ! command -v cursor >/dev/null 2>&1; then
  echo "cursor CLI not found, skipping extension install"
  exit 0
fi

LIST="{{ .chezmoi.sourceDir }}/.assets/cursor-extensions.txt"

while IFS= read -r ext; do
  [ -z "${ext}" ] && continue
  case "${ext}" in
    \#*) continue ;;
  esac
  cursor --install-extension "${ext}" --force >/dev/null
done < "${LIST}"

echo "cursor extensions sync complete"
