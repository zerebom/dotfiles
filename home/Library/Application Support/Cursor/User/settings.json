{
    "workbench.colorTheme": "Bearded Theme Milkshake Mango",
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "search.exclude": {
        "**/.venv/**": true
    },
    "files.exclude": {
        "**/.venv/**": true
    },
    "vim.hlsearch": true,
    "vim.useSystemClipboard": true,
    "editor.formatOnSave": false,
    "files.autoSave": "onFocusChange",
    "redhat.telemetry.enabled": true,
    "vim.vimrc.enable": true,
    "editor.accessibilitySupport": "off",
    "jupyter.runStartupCommands": [
        "%load_ext autoreload",
        "%autoreload 2"
    ],
    "files.insertFinalNewline": true,
    "python.analysis.autoFormatStrings": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            // "source.organizeImports": "explicit"
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        }
    },
    "mypy-type-checker.args": [
        "--config=pyproject.toml"
    ],
    "notebook.formatOnCellExecution": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": true,
        "notebook.source.organizeImports": true
    },
    "notebook.experimental.cellChat": true,
    "editor.minimap.autohide": true,
    "jupyter.showVariableViewWhenDebugging": true,
    "[yaml]": {
        //"editor.defaultFormatter": "redhat.vscode-yaml"
        "editor.formatOnSave": false // ← これを追記
    },
    "workbench.startupEditor": "none",
    "python.analysis.extraPaths": [
        "/home/zerebom/.cache/pypoetry/virtualenvs/atma-16-JhU7aZ4q-py3.11/lib/python3.11/site-packages"
    ],
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "explorer.confirmDelete": false,
    "[dockerfile]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "window.zoomLevel": 1,
    "files.associations": {
        "*.sql": "jinja-sql",
        //"*.yml": "jinja-yaml",
        "*.hbs": "ansi"
    },
    "[jinja-sql]": {
        "editor.defaultFormatter": "innoverio.vscode-dbt-power-user",
        "editor.formatOnSave": true
    },
    "[javascript]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "denoland.vscode-deno"
        // "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "deno.enable": true,
    "deno.lint": true,
    // "[typescriptreact]": {
    //     "editor.formatOnSave": true,
    //     "editor.defaultFormatter": "esbenp.prettier-vscode"
    // },
    "svg.preview.mode": "svg",
    "github.copilot.chat.localeOverride": "en",
    "explorer.confirmDragAndDrop": false,
    "dbt.sqlFmtPath": "/Users/zerebom/.rye/shims/sqlfmt",
    "dbt.sqlFmtAdditionalParams": [
        "sqlfmt ."
    ],
    "dbt.enableNewDocsPanel": true,
    "dbt.enableNewLineagePanel": true,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "git.autofetch": true,
    "python.interpreter.infoVisibility": "always",
    "githubPullRequests.pullBranch": "never",
    "cSpell.userWords": [
        "tqdm"
    ],
    "diffEditor.ignoreTrimWhitespace": true,
    "prisma.showPrismaDataPlatformNotification": false,
    "github.copilot.editor.enableAutoCompletions": true,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "git.enableSmartCommit": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "git.openRepositoryInParentFolders": "always",
    "mypy-type-checker.severity": {
        "error": "Warning"
    },
    "mypy-type-checker.preferDaemon": false,
    "mypy-type-checker.showNotifications": "onWarning",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "roo-cline.allowedCommands": [
        "npm test",
        "npm install",
        "tsc",
        "git log",
        "git diff",
        "git show"
    ],
    "cursor.cpp.enablePartialAccepts": true,
    "update.releaseTrack": "prerelease",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "[ansi]": {
        "editor.formatOnSave": false
    },
    "javascript.updateImportsOnFileMove.enabled": "always",
    "makefile.configureOnOpen": false,
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "cursor.composer.shouldAutoAcceptDiffs": false,
    "peacock.favoriteColors": [
        {
            "name": "Angular Red",
            "value": "#dd0531"
        },
        {
            "name": "Azure Blue",
            "value": "#007fff"
        },
        {
            "name": "JavaScript Yellow",
            "value": "#f9e64f"
        },
        {
            "name": "Mandalorian Blue",
            "value": "#1857a4"
        },
        {
            "name": "Node Green",
            "value": "#215732"
        },
        {
            "name": "React Blue",
            "value": "#61dafb"
        },
        {
            "name": "Something Different",
            "value": "#832561"
        },
        {
            "name": "Svelte Orange",
            "value": "#ff3d00"
        },
        {
            "name": "Vue Green",
            "value": "#42b883"
        }
    ],
    "cursor.general.disableHttp2": true,
    "cursor.composer.supportsTodos": false,
    "chatgpt.cliExecutable": "",
    "yaml.format.bracketSpacing": false,
    "yaml.format.enable": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "workbench.editorAssociations": {
        "*.svg": "hediet.vscode-drawio-text",
        "*.tsv": "xlsxViewer.tsv"
    },
    "hediet.vscode-drawio.resizeImages": null,
    "claudeCode.preferredLocation": "panel",
    "xlsxViewer.csv.firstRowIsHeader": true,
    "xlsxViewer.csv.stickyHeader": false,
    "xlsxViewer.csv.stickyToolbar": true
}
