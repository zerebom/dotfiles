{{/*
  シークレットは keychain から取得（CI では fake 値）
  投入: security add-generic-password -s <service> -a zerebom -w <value>
*/}}
{{- if env "CI" }}
export GEMINI_API_KEY="ci-fake-key"
export GITHUB_TOKEN="ci-fake-token"
export ANTHROPIC_API_KEY="ci-fake-key"
{{- else }}
export GEMINI_API_KEY="{{ keyring "gemini-api-key" "zerebom" | default "" }}"
export GITHUB_TOKEN="{{ keyring "github-token" "zerebom" | default "" }}"
export ANTHROPIC_API_KEY="{{ keyring "anthropic-api-key" "zerebom" | default "" }}"
{{- end }}
