{{/*
  シークレットを keychain から取得。投入が無いキーは空文字にフォールバックする。
  投入: security add-generic-password -s <service> -a zerebom -w <value>
  CI 環境では env "CI" ガードで fake 値を返す。
*/}}
{{- if env "CI" }}
export GITHUB_TOKEN="ci-fake-token"
export GEMINI_API_KEY="ci-fake-key"
export ANTHROPIC_API_KEY="ci-fake-key"
{{- else if eq .chezmoi.os "darwin" }}
{{- $github    := output "sh" "-c" "security find-generic-password -s github-token       -a zerebom -w 2>/dev/null || true" | trim }}
{{- $gemini    := output "sh" "-c" "security find-generic-password -s gemini-api-key     -a zerebom -w 2>/dev/null || true" | trim }}
{{- $anthropic := output "sh" "-c" "security find-generic-password -s anthropic-api-key  -a zerebom -w 2>/dev/null || true" | trim }}
export GITHUB_TOKEN="{{ $github }}"
export GEMINI_API_KEY="{{ $gemini }}"
export ANTHROPIC_API_KEY="{{ $anthropic }}"
{{- else }}
{{/* Linux 等: 必要になったら secret-tool / pass などで実装 */}}
export GITHUB_TOKEN=""
export GEMINI_API_KEY=""
export ANTHROPIC_API_KEY=""
{{- end }}
